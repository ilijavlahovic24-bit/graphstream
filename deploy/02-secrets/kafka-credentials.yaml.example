# Copy to `kafka-credentials.yaml` and fill in the credentials, then apply
# to the namespace where GraphStreamCluster resources are created.
#
# Reference it from a GraphStreamCluster via:
#   spec.kafka.credentialsSecret: graphstream-kafka-credentials
apiVersion: v1
kind: Secret
metadata:
  name: graphstream-kafka-credentials
  namespace: graphstream-clusters
type: Opaque
stringData:
  SASL_USERNAME: "replace-me"
  SASL_PASSWORD: "replace-me"